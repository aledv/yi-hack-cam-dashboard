# Copy this file to .env and edit the values. Never commit .env.

# --- Login (single user) ---
ADMIN_USER=admin
# Generate with: python scripts/hash_password.py "your-password" (use the $$-escaped line)
ADMIN_PASSWORD_HASH=
# Long random string used to sign the session cookie, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Interface language: en (default) or it. Each browser can switch with EN/IT in the top bar. ---
LANGUAGE=en

# --- Notifications (all optional; every configured channel gets each alert) ---
# Telegram: create a bot with @BotFather, then get your chat id (e.g. from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ntfy: full topic URL (pick a hard-to-guess topic on the public server, or use your own ntfy)
NTFY_URL=
# Access token, only for protected topics
NTFY_TOKEN=
# Generic webhook: multipart POST with "message" and an optional "file" (the snapshot)
WEBHOOK_URL=

# --- MQTT: motion events from the cameras (yi-hack MQTT settings) ---
# Leave MQTT_HOST empty to disable motion popups, counters and notifications.
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=

# --- Live view through a reverse proxy / HTTPS ---
# The Live page loads HLS straight from MediaMTX (port 8888). Empty = same host as
# the page, port 8888 (fine on the LAN over plain http). Behind HTTPS, proxy MediaMTX
# on its own hostname and put its base URL here, e.g. https://live.example.com
MEDIAMTX_PUBLIC_BASE=

# --- Recordings on a network share (no inotify events): polling interval in seconds ---
RECORDINGS_POLL_SECONDS=

# --- Docker Compose only (read by docker-compose.yml) ---
# Folder on the host with the clips uploaded by the cameras
RECORDINGS_DIR=./recordings
APP_PORT=8055
